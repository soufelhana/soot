<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <!-- Take advantage of SSO Gitlab -> GCP to authenticate to GCP Artifact registry -->
        <server>
            <id>artifact-registry</id>
            <username>${GITLAB_USER}</username>
            <password>${GITLAB_TOKEN}</password>
        </server>
    </servers>

    <mirrors>
        <mirror>
            <id>alternate-mvn-central-mirror</id>
            <mirrorOf>central</mirrorOf>
            <name>Google Maven Central Mirror</name>
            <url>https://maven-central-eu.storage-download.googleapis.com/maven2</url>
        </mirror>
    </mirrors>

    <pluginGroups>
        <pluginGroup>com.bforbank.backend.maven</pluginGroup>
        <pluginGroup>org.apache.maven.plugins</pluginGroup>
        <pluginGroup>org.codehaus.mojo</pluginGroup>
        <pluginGroup>org.sonarsource.scanner.maven</pluginGroup>
        <pluginGroup>se.bjurr.gitchangelog</pluginGroup>
        <pluginGroup>org.cyclonedx</pluginGroup>
    </pluginGroups>

    <profiles>
        <profile>
            <id>default_profile</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <repositories>
                <repository>
                    <id>artifact-registry-remote-maven-central</id>
                    <url>artifactregistry://europe-maven.pkg.dev/bfb-gitlabrunner-sbox-0a46/mvn-central</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
                <repository>
                    <id>artifact-registry-remote-confluent</id>
                    <url>artifactregistry://europe-maven.pkg.dev/bfb-gitlabrunner-sbox-0a46/confluent</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
                <repository>
                    <id>artifact-registry-repo-mvn-bforbank-mvn</id>
                    <url>artifactregistry://europe-maven.pkg.dev/bfb-gitlabrunner-sbox-0a46/mvn</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
                <repository>
                    <id>old-artifact-registry</id>
                    <url>
                        artifactregistry://europe-west1-maven.pkg.dev/bfb-gitlabrunner-sbox-0a46/mvn-dependencies-test
                    </url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
                <repository>
                    <id>repo-wso2</id>
                    <url>https://maven.wso2.org/nexus/content/repositories/wso2-public</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>artifact-registry-repo-mvn-bforbank-mvn-central</id>
                    <url>artifactregistry://europe-maven.pkg.dev/bfb-gitlabrunner-sbox-0a46/mvn-central</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>
                <pluginRepository>
                    <id>artifact-registry-repo-mvn-bforbank-mvn</id>
                    <url>artifactregistry://europe-maven.pkg.dev/bfb-gitlabrunner-sbox-0a46/mvn</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </pluginRepository>
                <pluginRepository>
                    <id>old-artifact-registry</id>
                    <url>
                        artifactregistry://europe-west1-maven.pkg.dev/bfb-gitlabrunner-sbox-0a46/mvn-dependencies-test
                    </url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </pluginRepository>
                <pluginRepository>
                    <id>artifact-registry-remote-confluent</id>
                    <url>artifactregistry://europe-maven.pkg.dev/bfb-gitlabrunner-sbox-0a46/confluent</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>
</settings>
